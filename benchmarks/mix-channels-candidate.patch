+    const int fromTo[] = {0, 1, 1, 2, 2, 0};
+    cv::mixChannels(&src, 1, &dst, 1, fromTo, 3);
+
+    EXPECT_EQ(Vec3b(11, 22, 33), pixels.front());
+    EXPECT_EQ(Vec3b(33, 11, 22), pixels[1]);
